{
  "mcpServers": {
    "wco": {
      "command": "npx",
      "args": ["-y", "@cubiczan/wco-mcp"],
      "env": {
        "WCO_OFFLINE": "1"
      }
    },
    "phoenix": {
      "command": "npx",
      "args": ["-y", "@arizeai/phoenix-mcp"],
      "env": {
        "PHOENIX_API_KEY": "${PHOENIX_API_KEY}",
        "PHOENIX_BASE_URL": "https://app.phoenix.arize.com"
      }
    }
  }
}
